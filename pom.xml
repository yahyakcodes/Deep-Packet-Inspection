<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.packetanalyzer</groupId>
    <artifactId>packet-analyzer</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Packet Analyzer / DPI Engine (Java port)</name>
    <description>
        Java 21 port of the original C++ Packet Analyzer / DPI Engine project.
        Reads and writes .pcap files, performs deep packet inspection (SNI/HTTP
        Host extraction), classifies traffic by application, and supports
        blocking by IP, application, or domain.
    </description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Default class run by `mvn exec:java` and java -jar -->
        <exec.mainClass>com.packetanalyzer.dpi.DpiEngineApp</exec.mainClass>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- Test-only. No runtime dependencies: PCAP reading/writing is
             hand-rolled binary I/O (see PcapReader/PcapWriter), matching
             what the original C++ project actually does - it never uses
             libpcap either, so no Pcap4J/Npcap dependency is needed. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>packet-analyzer</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- Executable jar: `java -jar target/packet-analyzer.jar ...`
                 runs the DPI engine (DpiEngineApp) by default. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.packetanalyzer.dpi.DpiEngineApp</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Convenience: `mvn exec:java` / `mvn exec:java -Dexec.mainClass=...` -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
